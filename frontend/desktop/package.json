{
  "name": "desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Auto-editing screen recorder: auto zoom, cursor effects, captions, camera layouts. Free and open source.",
  "author": "Open-Recorder contributors",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "node scripts/prepare-bin.mjs && npm run build && electron-builder --win --publish never",
    "dist:mac": "node scripts/prepare-bin.mjs && npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@rec/shared": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^26.5.12",
    "immer": "^11.2.9",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "mediabunny": "^1.64.0"
  }
}
